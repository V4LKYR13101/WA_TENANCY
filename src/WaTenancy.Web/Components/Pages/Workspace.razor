@page "/"
@attribute [Authorize]
@implements IAsyncDisposable
@inject AuthenticationStateProvider Auth
@inject TenantAccess Access
@inject TenantService Tenants
@inject MessageService Messages
@inject AccountSupervisor Supervisor
@inject WebhookService Hooks
@inject WebhookEndpointPolicy WebhookEndpoints
@inject Microsoft.Extensions.Options.IOptions<AppOptions> Options

<PageTitle>Workspace · WaTenancy</PageTitle>
<header class="page-header" data-interactive="@(ready ? "ready" : "loading")"><div><div class="eyebrow">YOUR WHATSAPP OPERATIONS</div><h1>Company workspace<span class="heading-dot">.</span></h1><p class="muted">Every conversation belongs to the right company.</p></div><div class="workspace-select"><label for="company-select">CURRENT COMPANY</label><select id="company-select" @bind="selected" @bind:after="CompanyChanged" disabled="@(!ready || busy)">@if (companies.Count == 0) { <option value="@Guid.Empty">No companies yet</option> }@foreach (var company in companies) { <option value="@company.Id">@company.Name @(!company.IsEnabled ? "· Disabled" : "")</option> }</select></div></header>
@if (error is not null) { <div class="notice error" role="alert">@error<button class="notice-close" aria-label="Dismiss error" @onclick="() => error = null">×</button></div> }
@if (success is not null) { <div class="notice success" role="status">@success<button class="notice-close" aria-label="Dismiss message" @onclick="() => success = null">×</button></div> }
@if (loading) { <div class="empty-state"><span class="spinner"></span><h2>Opening your workspace…</h2></div> }
else {
@if (platform) {
<details class="company-controls" open="@(companies.Count == 0)"><summary>Manage companies <span>@companies.Count companies</span></summary><div class="company-control-body"><div class="form-row"><label>Company name<input @bind="companyName" placeholder="Acme Industries" maxlength="100" /></label><label>Company slug<input @bind="companySlug" placeholder="acme-industries" maxlength="50" /></label><button class="button primary" disabled="@busy" @onclick="CreateCompany">Create company</button></div>@if (CurrentCompany is not null) { <div class="inline-detail"><code>@CurrentCompany.Id</code><button class="button small danger" @onclick="() => confirmDisable = true">@(CurrentCompany.IsEnabled ? "Disable company" : "Enable company")</button></div> }</div></details>
}
@if (confirmDisable && CurrentCompany is not null) { <div class="notice warning"><strong>@(CurrentCompany.IsEnabled ? "Disable" : "Enable") @CurrentCompany.Name?</strong> Disabling stops its workers and blocks tenant access.<button class="button small danger" disabled="@busy" @onclick="ToggleCompany">Confirm</button><button class="button small" @onclick="() => confirmDisable = false">Cancel</button></div> }
@if (companies.Count == 0) { <section class="empty-state panel"><div class="empty-icon">▦</div><h2>Your companies start here</h2><p>@(platform ? "Create your first company above, then add its WhatsApp numbers and team." : "Ask your administrator to add you to a company.")</p></section> }
else if (CurrentCompany?.IsEnabled != true) { <section class="empty-state panel"><h2>This company is disabled</h2><p>Enable it to resume its workspace and WhatsApp workers.</p></section> }
else {
<div class="stats-grid"><section class="stat-card"><span>WHATSAPP NUMBERS</span><strong>@stats.Accounts<small>/ @Options.Value.MaxAccountsPerTenant</small></strong><p>Separate account sessions</p></section><section class="stat-card accent"><span>CONNECTED NOW</span><strong>@stats.Connected<span class="live-dot"></span></strong><p>Watching for new events</p></section><section class="stat-card"><span>OUTBOUND QUEUE</span><strong>@stats.Queued</strong><p>@stats.Failed failed or uncertain</p></section><section class="stat-card"><span>INCOMING MESSAGES</span><strong>@stats.Received</strong><p>@stats.WebhookPending webhook deliveries pending</p></section></div>
<div class="workspace-tabs" role="tablist" aria-label="Company workspace sections">@foreach (var item in Tabs) { <button role="tab" aria-selected="@(tab == item)" class="@(tab == item ? "active" : "")" @onclick="() => SetTab(item)">@item</button> }<span class="refresh-note"><span class="live-dot"></span> Updates every 3 seconds</span></div>
@if (tab == "Numbers") {
<section class="panel"><div class="section-heading"><div><h2>WhatsApp connections</h2><p class="muted">Connect each company number, then keep its watcher running.</p></div><span class="pill">@accounts.Count numbers</span></div>
@if (CanAdmin) { <div class="add-number"><label>Number label<input @bind="accountName" placeholder="Sales · Johannesburg" maxlength="100" /></label><button class="button primary" disabled="@busy" @onclick="AddAccount">+ Add number</button></div> }
@if (accounts.Count == 0) { <div class="empty-state compact"><div class="empty-icon">◎</div><h2>Connect your first number</h2><p>Add a label, then scan its QR code from WhatsApp → Linked devices.</p></div> }
else { <div class="account-grid">@foreach (var account in accounts) { <article class="account-card"><div class="account-card-top"><span class="account-avatar">↗</span><span class="status @account.State.ToString().ToLowerInvariant()">@account.State</span></div><h3>@account.Name</h3><p class="number">@(string.IsNullOrEmpty(account.Phone) ? "Ready to link a WhatsApp number" : account.Phone)</p><div class="account-meta"><span>Watcher @(account.WatchEnabled ? "enabled" : "paused")</span><span>@(account.LastConnectedAt?.ToLocalTime().ToString("dd MMM HH:mm") ?? "Never connected")</span></div>@if (account.LastError is not null) { <p class="account-error">@account.LastError</p> }@if (CanAdmin) { <div class="account-actions">@if (!account.WatchEnabled && account.State is AccountState.Pairing or AccountState.Connecting) { <button class="button small" @onclick="() => ShowPair(account)">View pairing</button> } else if (!account.WatchEnabled && account.State is AccountState.NeedsPairing or AccountState.Disconnected or AccountState.Error) { <button class="button small primary" disabled="@busy" @onclick="() => BeginPair(account)">Connect number</button> }<button class="button small" disabled="@busy" @onclick="() => Watch(account)">@(account.WatchEnabled ? "Pause watch" : "Start watch")</button>@if (account.Phone is not null) { <button class="button small danger" @onclick="() => logoutAccount = account">Unlink</button> }</div> }</article> }</div> }
</section>
}
@if (tab == "Inbox") {
<section class="panel"><div class="section-heading"><div><h2>Company inbox</h2><p class="muted">Incoming messages and synced conversation history.</p></div><span class="pill">@Options.Value.RetentionDays-day retention</span></div><div class="form-row filters"><label>Search messages<input @bind="search" placeholder="Message, contact or chat ID" maxlength="100" /></label><label>Number<select @bind="inboxAccount"><option value="">All numbers</option>@foreach (var account in accounts) { <option value="@account.Id">@account.Name</option> }</select></label><button class="button" @onclick="SearchInbox">Search</button></div>
@if (inbox.Count == 0) { <div class="empty-state compact"><h2>No messages here yet</h2><p>Messages will appear as connected numbers sync. Try clearing your filters.</p></div> } else { <div class="message-list">@foreach (var message in inbox) { <article class="message-row"><span class="avatar">@(message.FromMe ? "↗" : "↙")</span><div class="message-content"><div class="message-heading"><strong>@(string.IsNullOrEmpty(message.ChatName) ? message.ChatJid : message.ChatName)</strong><span>@AccountLabel(message.AccountId)</span><time>@message.Timestamp.ToLocalTime().ToString("dd MMM, HH:mm")</time></div><p>@message.Text</p>@if (message.MediaType is not null) { <span class="pill">@message.MediaType attachment</span> }<small>@message.ChatJid · @(message.FromMe ? "Outbound" : "Incoming")</small></div>@if (CanSend) { <button class="button small" @onclick="() => Reply(message)">Reply ↗</button> }</article> }</div> }
<div class="pagination"><button class="button small" disabled="@(inboxPage <= 1)" @onclick="() => InboxPage(-1)">← Previous</button><span>Page @inboxPage</span><button class="button small" disabled="@(inbox.Count < 50)" @onclick="() => InboxPage(1)">Next →</button></div></section>
}
@if (tab == "Send") {
<div class="two-column"><section class="panel"><div class="section-heading"><div><h2>Send a message</h2><p class="muted">Send from a connected company number.</p></div><span class="pill">@CurrentCompany?.Name</span></div>
@if (!CanSend) { <div class="notice warning">An agent or administrator role is needed to send.</div> }
<EditForm Model="compose" OnValidSubmit="Send" FormName="send-message"><DataAnnotationsValidator /><ValidationSummary /><label>From number<InputSelect @bind-Value="compose.AccountId"><option value="@Guid.Empty">Choose a connected number</option>@foreach (var account in accounts.Where(x => x.WatchEnabled && x.State == AccountState.Connected)) { <option value="@account.Id">@account.Name · @account.Phone</option> }</InputSelect></label><label>Recipient<InputText @bind-Value="compose.Recipient" placeholder="+27821234567" maxlength="200" /><small>International phone number or WhatsApp chat JID.</small></label><label>Message<InputTextArea @bind-Value="compose.Text" rows="6" maxlength="4096" placeholder="Write your message…" /><small>@compose.Text.Length / 4096 characters</small></label><label class="upload-label">Attach a file · up to @(Options.Value.MaxUploadBytes / 1024 / 1024) MB<InputFile OnChange="Upload" disabled="@(!CanSend || busy)" /></label>@if (upload is not null) { <div class="uploaded-file">▤ @upload.Name <small>@(upload.Length / 1024) KB</small><button type="button" class="button small" @onclick="() => upload = null">Remove</button></div> }<button type="submit" class="button primary full" disabled="@(!CanSend || busy || compose.AccountId == Guid.Empty)">@(busy ? "Working…" : "Queue message →")</button></EditForm></section><aside class="panel tips"><span class="eyebrow">BEFORE YOU SEND</span><h2>The right number.<br />The right company.</h2><p>Only this company’s connected numbers can send.</p><div class="tip"><strong>Queued isn’t delivered</strong><p>Track messages in Outbox. Sent means WhatsApp accepted the message; receipts update delivery and read status.</p></div><div class="tip"><strong>Uncertain result?</strong><p>Check the conversation before sending again. An uncertain message is never automatically repeated.</p></div><div class="tip"><strong>Supported content</strong><p>Text and file attachments. Interactive option lists aren’t supported by this version of wacli.</p></div></aside></div>
}
@if (tab == "Outbox") {
<section class="panel"><div class="section-heading"><div><h2>Outbound messages</h2><p class="muted">Queue, acceptance and delivery status for this company.</p></div></div>@if (jobs.Count == 0) { <div class="empty-state compact"><h2>Your outbox is clear</h2><p>Messages you queue will appear here.</p></div> } else { <div class="table-wrap"><table><thead><tr><th>Message</th><th>Number / recipient</th><th>Status</th><th>Created</th><th></th></tr></thead><tbody>@foreach (var job in jobs) { <tr><td><div class="message-preview">@(job.Text.Length == 0 ? "File attachment" : job.Text)</div>@if (job.Error is not null) { <small class="error-text">@job.Error</small> }<small class="mono">@job.Id</small></td><td>@AccountLabel(job.AccountId)<small>@job.Recipient</small></td><td><span class="status @job.State.ToString().ToLowerInvariant()">@job.State</span><small>Attempts: @job.Attempts</small>@if (job.State == JobState.Queued && job.Attempts > 0) { <small>Next try: @job.NextAttemptAt.ToLocalTime().ToString("HH:mm:ss")</small> }</td><td>@job.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm")</td><td>@if (CanSend && job.State == JobState.Queued) { <button class="button small" disabled="@busy" @onclick="() => CancelJob(job)">Cancel</button> }@if (CanSend && job.State == JobState.Failed) { <button class="button small" disabled="@busy" @onclick="() => RetryJob(job)">Retry send</button> }</td></tr> }</tbody></table></div> }<div class="pagination"><button class="button small" disabled="@(jobsPage <= 1)" @onclick="() => JobsPage(-1)">← Previous</button><span>Page @jobsPage</span><button class="button small" disabled="@(jobs.Count < 50)" @onclick="() => JobsPage(1)">Next →</button></div></section>
}
@if (tab == "Webhooks") {
<div class="two-column"><section class="panel"><div class="section-heading"><div><h2>Company webhook profile</h2><p class="muted">Forward incoming events to your company’s application.</p></div></div><label>Webhook URL<input type="url" @bind="webhookUrl" placeholder="https://your-app.com/webhooks/whatsapp" maxlength="2048" /><small>Public HTTPS endpoint on port 443.@if (WebhookEndpoints.LocalReceiverUrls.Any()) { <span> Development also allows: @string.Join(" or ", WebhookEndpoints.LocalReceiverUrls).</span> }</small></label><label class="checkbox-label"><input type="checkbox" @bind="webhookEnabled" /> Enable event forwarding</label><div class="button-row"><button class="button primary" disabled="@busy" @onclick="SaveWebhook">Save profile</button><button class="button" disabled="@(!webhookEnabled || busy)" @onclick="TestWebhook">Send test event</button></div><hr /><h3>Signing secret</h3><p class="muted">Verify requests before processing. Rotation shows the new secret once. Queued events retain their original secret.</p><button class="button" disabled="@busy" @onclick="RotateSecret">Generate / rotate secret</button>@if (webhookSecret is not null) { <div class="secret-box"><strong>Save this secret now</strong><textarea readonly rows="2" aria-label="Webhook signing secret">@webhookSecret</textarea><small>It will not be displayed again.</small></div> }</section><aside class="panel tips"><span class="eyebrow">EVENT DELIVERY</span><h2>Your app.<br />Your workflows.</h2><p>Each JSON envelope includes an event ID, company ID, account ID, event type and data.</p><div class="tip"><strong>At least once</strong><p>Return HTTP 2xx. Failed requests are retried up to 8 times. Deduplicate using eventId.</p></div><div class="tip"><strong>Verify the signature</strong><p>HMAC-SHA256 over timestamp + “.” + the exact body. Headers carry the signature, timestamp and event ID.</p></div><a class="text-link" href="/api-guide">Read the integration guide →</a></aside></div>
<section class="panel"><div class="section-heading"><h2>Webhook delivery history</h2><span class="pill">Latest events</span></div>@if (deliveries.Count == 0) { <div class="empty-state compact"><h2>No deliveries yet</h2><p>Enable your endpoint, then send a test event.</p></div> } else { <div class="table-wrap"><table><thead><tr><th>Event</th><th>Status</th><th>Attempts</th><th>Response</th><th>Created</th><th></th></tr></thead><tbody>@foreach (var delivery in deliveries) { <tr><td><strong>@delivery.EventType</strong><small class="mono">@delivery.Id</small>@if (delivery.LastError is not null) { <small class="error-text">@delivery.LastError</small> }</td><td><span class="status @delivery.State.ToLowerInvariant()">@delivery.State</span></td><td>@delivery.Attempts / 8</td><td>@(delivery.LastStatusCode?.ToString() ?? "—")</td><td>@delivery.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm")</td><td>@if (delivery.State == "Failed" || delivery.State == "Pending" && delivery.Attempts > 0) { <button class="button small" disabled="@busy" @onclick="() => RetryWebhook(delivery)" title="Retry using the current webhook URL and signing secret">Retry with current profile</button> }</td></tr> }</tbody></table></div> }<div class="pagination"><button class="button small" disabled="@(deliveryPage <= 1)" @onclick="() => DeliveryPage(-1)">← Previous</button><span>Page @deliveryPage</span><button class="button small" disabled="@(deliveries.Count < 50)" @onclick="() => DeliveryPage(1)">Next →</button></div></section>
}
@if (tab == "Team") {
<section class="panel"><div class="section-heading"><div><h2>Company team</h2><p class="muted">People with access to @CurrentCompany?.Name.</p></div></div><div class="form-row"><label>Email<input type="email" @bind="memberEmail" maxlength="254" placeholder="colleague@company.com" /></label><label>Initial password<input type="password" @bind="memberPassword" autocomplete="new-password" placeholder="For new users" /></label><label>Role<select @bind="memberRole">@foreach (var role in Enum.GetValues<TenantRole>().Where(x => x != TenantRole.Owner || tenantRole == TenantRole.Owner)) { <option value="@role">@role</option> }</select></label><button class="button primary" disabled="@busy" @onclick="AddMember">Add member</button></div><p class="fine-print">Existing users keep their password. Share new credentials privately. Viewer: read. Agent: send. Admin: manage numbers and integrations. Owner: manage owners.</p><div class="table-wrap"><table><thead><tr><th>Email</th><th>Company role</th><th></th></tr></thead><tbody>@foreach (var member in members) { <tr><td>@member.Email</td><td><span class="pill">@member.Role</span></td><td><button class="button small danger" @onclick="() => removeMember = member">Remove access</button></td></tr> }</tbody></table></div></section>
}
@if (tab == "API keys") {
<section class="panel"><div class="section-heading"><div><h2>Company API keys</h2><p class="muted">Keys belong only to this company. Revoke access at any time.</p></div><a class="text-link" href="/api-guide">API guide →</a></div><div class="form-row"><label>Key label<input @bind="keyName" placeholder="CRM integration" maxlength="100" /></label><label>Expires in days<input type="number" @bind="keyDays" min="1" max="365" /></label><button class="button primary" disabled="@busy" @onclick="CreateKey">Create key</button></div><div class="button-row"><label class="checkbox-label"><input type="checkbox" @bind="keySend" /> Allow sending messages</label><label class="checkbox-label"><input type="checkbox" @bind="keyManage" /> Allow account pairing and management</label></div>@if (newKey is not null) { <div class="secret-box"><strong>Copy this key now</strong><textarea readonly rows="2" aria-label="New API key">@newKey</textarea><small>Only its hash is stored. Copy it before leaving this page.</small></div> }<div class="table-wrap"><table><thead><tr><th>Key</th><th>Permissions</th><th>Expires</th><th></th></tr></thead><tbody>@foreach (var key in keys) { <tr><td><strong>@key.Name</strong><small class="mono">@key.Prefix…</small></td><td>Read @(key.CanSend ? "· Send" : "") @(key.CanManageAccounts ? "· Manage accounts" : "")</td><td>@key.ExpiresAt?.ToString("dd MMM yyyy")</td><td>@if (key.RevokedAt is null) { <button class="button small danger" disabled="@busy" @onclick="() => RevokeKey(key)">Revoke</button> } else { <span class="status paused">Revoked</span> }</td></tr> }</tbody></table></div></section>
}
@if (tab == "Activity") {
<section class="panel"><div class="section-heading"><h2>Company activity</h2><span class="pill">Latest 100 entries</span></div>@if (audit.Count == 0) { <p class="muted">No activity yet.</p> }<div class="table-wrap"><table><thead><tr><th>Action</th><th>Actor</th><th>Detail</th><th>Time</th></tr></thead><tbody>@foreach (var entry in audit) { <tr><td><strong>@entry.Action</strong></td><td class="mono">@entry.Actor</td><td class="mono">@entry.Detail</td><td>@entry.Timestamp.ToLocalTime().ToString("dd MMM HH:mm:ss")</td></tr> }</tbody></table></div></section>
}
}
}
@if (pairAccount is not null) {
<div class="modal-backdrop"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="pair-title"><button class="modal-close" aria-label="Close pairing dialog" @onclick="() => pairAccount = null">×</button><div class="eyebrow">LINK A WHATSAPP NUMBER</div><h2 id="pair-title">Connect @pairAccount.Name</h2><p class="muted">On the phone, open WhatsApp → Linked devices → Link a device.</p>@if (pairView?.QrImage is not null) { <img class="pairing-qr" src="@pairView.QrImage" alt="WhatsApp device linking QR code" /> } else if (pairView?.PairCode is not null) { <div class="pair-code">@pairView.PairCode</div><p>Choose “Link with phone number” and enter this code.</p> } else if (pairView?.State == AccountState.Connected) { <div class="notice success">Connected. Your watcher is running.</div> } else { <div class="qr-placeholder"><span class="spinner"></span><p>Waiting for pairing information…</p></div> }@if (pairView?.ExpiresAt is not null) { <small>Current code expires at @pairView.ExpiresAt?.ToLocalTime().ToString("HH:mm:ss").</small> }<details class="phone-pair"><summary>Pair using a phone number instead</summary><label>International phone number<input @bind="pairPhone" placeholder="+27821234567" /></label><button class="button" disabled="@busy" @onclick="PhonePair">Generate phone code</button></details><div class="button-row"><button class="button" disabled="@busy" @onclick="RefreshPair">Generate new QR</button><button class="button" @onclick="() => pairAccount = null">Close</button></div><p class="fine-print">Closing keeps pairing active until it completes or expires.</p></section></div>
}
@if (logoutAccount is not null) { <div class="modal-backdrop"><section class="modal" role="dialog" aria-modal="true"><h2>Unlink @logoutAccount.Name?</h2><p>This stops its watcher and invalidates the session. You will need to pair it again.</p><button class="button danger" disabled="@busy" @onclick="LogoutNumber">Unlink number</button><button class="button" @onclick="() => logoutAccount = null">Cancel</button></section></div> }
@if (removeMember is not null) { <div class="modal-backdrop"><section class="modal" role="dialog" aria-modal="true"><h2>Remove company access?</h2><p>@removeMember.Email will lose access to @CurrentCompany?.Name.</p><button class="button danger" disabled="@busy" @onclick="RemoveTeamMember">Remove access</button><button class="button" @onclick="() => removeMember = null">Cancel</button></section></div> }

@code {
    private bool loading = true, busy, platform, confirmDisable, ready; private string? error, success;
    private List<Tenant> companies = []; private Guid selected; private Tenant? CurrentCompany => companies.FirstOrDefault(x => x.Id == selected);
    private TenantRole tenantRole; private bool CanAdmin => tenantRole >= TenantRole.Admin; private bool CanSend => tenantRole >= TenantRole.Agent;
    private string tab = "Numbers";
    private IEnumerable<string> Tabs => CanAdmin ? ["Numbers", "Inbox", "Send", "Outbox", "Webhooks", "Team", "API keys", "Activity"] : ["Numbers", "Inbox", "Send", "Outbox"];
    private DashboardStats stats = new(0, 0, 0, 0, 0, 0);
    private List<WhatsAppAccount> accounts = []; private List<InboxMessage> inbox = []; private List<JobView> jobs = []; private List<MemberView> members = []; private List<KeyView> keys = []; private List<AuditEntry> audit = []; private List<DeliveryView> deliveries = [];
    private string companyName = "", companySlug = "", accountName = "", search = "", memberEmail = "", memberPassword = "", keyName = "", webhookUrl = "", pairPhone = "";
    private Guid? inboxAccount; private int inboxPage = 1, jobsPage = 1, deliveryPage = 1, keyDays = 90; private bool keySend = true, keyManage, webhookEnabled;
    private TenantRole memberRole = TenantRole.Agent; private string? newKey, webhookSecret; private WhatsAppAccount? pairAccount, logoutAccount; private PairingView? pairView; private MemberView? removeMember;
    private ComposeModel compose = new(); private StoredFile? upload; private string requestKey = Guid.NewGuid().ToString(), requestFingerprint = "";
    private CancellationTokenSource cancellation = new(); private Task? polling;
    private async Task<ClaimsPrincipal> Principal() => (await Auth.GetAuthenticationStateAsync()).User;
    protected override async Task OnInitializedAsync() { try { var p = await Principal(); platform = await Access.IsPlatformAdmin(p); companies = await Access.Companies(p); selected = companies.FirstOrDefault()?.Id ?? Guid.Empty; await CompanyChanged(); } catch (AppException ex) { error = ex.Message; } finally { loading = false; } }
    protected override Task OnAfterRenderAsync(bool firstRender) { if (firstRender) { ready = true; polling = Poll(); StateHasChanged(); } return Task.CompletedTask; }
    private async Task Poll() { using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3)); try { while (await timer.WaitForNextTickAsync(cancellation.Token)) await InvokeAsync(async () => { if (busy || selected == Guid.Empty || CurrentCompany?.IsEnabled != true) return; try { await Refresh(); if (pairAccount is not null) pairView = await Supervisor.Pairing(await Principal(), selected, pairAccount.Id); StateHasChanged(); } catch (AppException ex) { error = ex.Message; } }); } catch (OperationCanceledException) { } }
    private async Task CompanyChanged() { error = success = null; newKey = webhookSecret = null; pairAccount = logoutAccount = null; removeMember = null; confirmDisable = false; upload = null; compose = new(); inboxPage = jobsPage = deliveryPage = 1; inboxAccount = null; search = ""; tab = "Numbers"; if (selected == Guid.Empty || CurrentCompany?.IsEnabled != true) return; tenantRole = await Access.Require(await Principal(), selected); await Refresh(); if (CanAdmin) { var profile = await Tenants.Webhook(await Principal(), selected); webhookUrl = profile.Url ?? ""; webhookEnabled = profile.Enabled; } }
    private async Task Refresh() { var p = await Principal(); var id = selected; tenantRole = await Access.Require(p, id); if (!Tabs.Contains(tab)) tab = "Numbers"; accounts = await Tenants.Accounts(p, id); stats = await Tenants.Stats(p, id); switch (tab) { case "Inbox": inbox = await Messages.Inbox(p, id, inboxAccount, search, inboxPage); break; case "Outbox": jobs = await Messages.Jobs(p, id, jobsPage); break; case "Team": members = await Tenants.Members(p, id); break; case "API keys": keys = await Tenants.Keys(p, id); break; case "Activity": audit = await Tenants.AuditLog(p, id); break; case "Webhooks": deliveries = await Hooks.List(p, id, deliveryPage); break; } }
    private async Task Run(Func<Task> action, string? message = null) { if (busy) return; busy = true; error = success = null; try { await action(); if (message is not null) success = message; if (selected != Guid.Empty && CurrentCompany?.IsEnabled == true) await Refresh(); } catch (AppException ex) { error = ex.Message; } catch (Exception) { error = "The operation could not be completed. Check server logs and try again."; } finally { busy = false; } }
    private Task SetTab(string value) => Run(async () => { tab = value; await Refresh(); });
    private Task CreateCompany() => Run(async () => { var company = await Tenants.CreateCompany(await Principal(), companyName, companySlug); companies = await Access.Companies(await Principal()); selected = company.Id; companyName = companySlug = ""; await CompanyChanged(); }, "Company created. Add its numbers and team next.");
    private Task ToggleCompany() => Run(async () => { if (CurrentCompany is null) return; await Tenants.SetCompanyEnabled(await Principal(), selected, !CurrentCompany.IsEnabled); companies = await Access.Companies(await Principal()); confirmDisable = false; await CompanyChanged(); });
    private Task AddAccount() => Run(async () => { await Tenants.CreateAccount(await Principal(), selected, accountName); accountName = ""; }, "Number added. Connect it to WhatsApp.");
    private Task BeginPair(WhatsAppAccount account) => Run(async () => { await Supervisor.StartPairing(await Principal(), selected, account.Id); pairAccount = account; pairView = null; });
    private Task ShowPair(WhatsAppAccount account) => Run(async () => { pairAccount = account; pairView = await Supervisor.Pairing(await Principal(), selected, account.Id); });
    private Task RefreshPair() => pairAccount is null ? Task.CompletedTask : BeginPair(pairAccount);
    private Task PhonePair() => Run(async () => { if (pairAccount is null) return; await Supervisor.StartPairing(await Principal(), selected, pairAccount.Id, pairPhone); pairView = null; });
    private Task Watch(WhatsAppAccount account) => Run(async () => await Supervisor.SetWatch(await Principal(), selected, account.Id, !account.WatchEnabled));
    private Task LogoutNumber() => Run(async () => { if (logoutAccount is null) return; await Supervisor.Logout(await Principal(), selected, logoutAccount.Id); logoutAccount = null; });
    private string AccountLabel(Guid id) => accounts.FirstOrDefault(x => x.Id == id)?.Name ?? "Unknown number";
    private Task SearchInbox() => Run(async () => { inboxPage = 1; inbox = await Messages.Inbox(await Principal(), selected, inboxAccount, search); });
    private Task InboxPage(int delta) => Run(async () => { inboxPage = Math.Max(1, inboxPage + delta); await Refresh(); });
    private Task JobsPage(int delta) => Run(async () => { jobsPage = Math.Max(1, jobsPage + delta); await Refresh(); });
    private Task DeliveryPage(int delta) => Run(async () => { deliveryPage = Math.Max(1, deliveryPage + delta); await Refresh(); });
    private Task Reply(InboxMessage message) => Run(() => { tab = "Send"; compose.AccountId = message.AccountId; compose.Recipient = message.ChatJid; compose.Text = ""; upload = null; return Task.CompletedTask; });
    private Task Upload(InputFileChangeEventArgs args) => Run(async () => { var file = args.File; await using var stream = file.OpenReadStream(Options.Value.MaxUploadBytes, cancellation.Token); upload = await Messages.Upload(await Principal(), selected, file.Name, file.ContentType, stream, file.Size, cancellation.Token); }, "File uploaded.");
    private Task Send() => Run(async () => { var request = new SendRequest(compose.AccountId, compose.Recipient, compose.Text, upload?.Id); var fingerprint = System.Text.Json.JsonSerializer.Serialize(request); if (fingerprint != requestFingerprint) { requestKey = Guid.NewGuid().ToString(); requestFingerprint = fingerprint; } await Messages.Enqueue(await Principal(), selected, request, requestKey); compose.Text = ""; upload = null; requestFingerprint = ""; tab = "Outbox"; }, "Message queued. Track its status in the outbox.");
    private Task RetryJob(JobView job) => Run(async () => await Messages.Retry(await Principal(), selected, job.Id), "Message requeued for sending.");
    private Task CancelJob(JobView job) => Run(async () => await Messages.Cancel(await Principal(), selected, job.Id));
    private Task AddMember() => Run(async () => { await Tenants.AddMember(await Principal(), selected, memberEmail, memberPassword, memberRole); memberEmail = memberPassword = ""; }, "Member added.");
    private Task RemoveTeamMember() => Run(async () => { if (removeMember is null) return; await Tenants.RemoveMember(await Principal(), selected, removeMember.UserId); removeMember = null; });
    private Task CreateKey() => Run(async () => { newKey = await Tenants.CreateKey(await Principal(), selected, keyName, keySend, keyManage, keyDays); keyName = ""; });
    private Task RevokeKey(KeyView key) => Run(async () => await Tenants.RevokeKey(await Principal(), selected, key.Id));
    private Task SaveWebhook() => Run(async () => await Tenants.SaveWebhook(await Principal(), selected, webhookUrl, webhookEnabled), "Webhook profile saved.");
    private Task RotateSecret() => Run(async () => webhookSecret = await Tenants.RotateWebhookSecret(await Principal(), selected));
    private Task TestWebhook() => Run(async () => await Hooks.Test(await Principal(), selected), "Test event queued. Check its delivery result below.");
    private Task RetryWebhook(DeliveryView d) => Run(async () => await Hooks.Retry(await Principal(), selected, d.Id), "Delivery queued for another attempt.");
    public async ValueTask DisposeAsync() { await cancellation.CancelAsync(); if (polling is not null) await polling; cancellation.Dispose(); }
    private sealed class ComposeModel { public Guid AccountId { get; set; } [System.ComponentModel.DataAnnotations.Required] public string Recipient { get; set; } = ""; [System.ComponentModel.DataAnnotations.MaxLength(4096)] public string Text { get; set; } = ""; }
}
